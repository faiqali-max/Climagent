# ============================================================
# CLIMAGENT - environment variables (copy to .env and fill in)
# This file is a template. Create your own .env from it and add
# real keys. NEVER commit .env. Never hardcode keys in source.
# ============================================================

# --- LLM (LangChain / LangGraph brain) ---
# The agent brain can be powered by EITHER:
#   (A) a single Google Gemini key below (GOOGLE_API_KEY) - RECOMMENDED, or
#   (B) any OpenAI-compatible provider (OPENAI / DeepSeek / Groq / Qwen / OpenRouter):
#       LLM_API_KEY=<your-key>  LLM_BASE_URL=https://.../v1  LLM_MODEL=<model>
# Leave LLM_API_KEY / LLM_BASE_URL blank if you use the Google key for the brain.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# --- Google Gemini / LLM API (OPTIONAL but recommended) ---
# When GOOGLE_API_KEY is set, it powers the agent BRAIN (via LangChain Gemini)
# AND the parallel "FortyGuard -> Google LLM" interpretation. Use the SAME key
# here that you use for Google, OR leave LLM_API_KEY/LLM_BASE_URL blank entirely.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Payoneer OAuth API (optional; ad-earnings payouts) ---
# Sandbox: https://api.sandbox.payoneer.com ; Production: https://api.payoneer.com
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_BASE_URL=

# --- Google AdSense API Gateway (optional; real ad embeds + credit economy) ---
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=

# --- FortyGuard Climate Data API ---
FORTYGUARD_API_KEY=

# --- LangSmith (optional observability / tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=climagent

# --- Heat Risk thresholds (°C). Admin dashboard can override these. ---
HEAT_RISK_LOW=27
HEAT_RISK_MODERATE=31
HEAT_RISK_HIGH=35
HEAT_RISK_EXTREME=40

# --- Bootstrap administrator (optional; created on first start) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Supabase (optional; for Supabase-backed storage/auth later) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (optional; modular provider - 'manual' used by default) ---
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=

# --- App ---
APP_URL=http://localhost:8000

# --- Storage (optional overrides; Fly.io/Railway use /data via volume) ---
# CLIMAGENT_DB=/data/climagent.db
# CLIMAGENT_STORAGE=/data/storage

# --- Email notifications (SMTP) ---
# In-app notifications always work. Emails only send when SMTP_HOST is set.
# Gmail example: use an App Password (not your normal login password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# SMTP_TLS=1
